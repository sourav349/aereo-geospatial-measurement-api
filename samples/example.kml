<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>AEREO demo survey</name>
    <Placemark id="plot-01">
      <name>Survey plot</name>
      <ExtendedData><Data name="site"><value>Bengaluru</value></Data></ExtendedData>
      <Polygon>
        <outerBoundaryIs><LinearRing><coordinates>
          77.5900,12.9700,0 77.5910,12.9700,0
          77.5910,12.9710,0 77.5900,12.9710,0 77.5900,12.9700,0
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark id="road-01">
      <name>Access road</name>
      <LineString><coordinates>77.5900,12.9700 77.5910,12.9710</coordinates></LineString>
    </Placemark>
    <Placemark id="marker-01">
      <name>Survey marker</name>
      <Point><coordinates>77.5905,12.9705</coordinates></Point>
    </Placemark>
  </Document>
</kml>
